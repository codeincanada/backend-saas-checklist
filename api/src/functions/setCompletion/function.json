{
  "bindings": [
    {
      "authLevel": "anonymous", // Or "function" or "admin" based on your auth needs
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["post", "put"],
      "route": "completion" // Optional: defines the route, e.g., /api/completion
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "table",
      "tableName": "UserTaskCompletions",
      "connection": "AzureWebJobsStorage", // App setting name for Storage connection string
      "direction": "out",
      "name": "outputTable" // This is how you'll refer to the output binding in code
    }
  ],
  "scriptFile": "../../dist/setCompletion/index.js" // Path to the compiled JS file
} 